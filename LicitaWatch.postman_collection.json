{
  "info": {
    "name": "LicitaWatch",
    "description": "Coleccion de pruebas end-to-end para LicitaWatch, contra el API Gateway (puerto 8080). Los requests de login guardan el token automaticamente en las variables de coleccion (tokenEmpresa/tokenCliente/tokenAdmin) para que el resto de los requests los usen solos.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "emailEmpresa", "value": "postman-empresa@test.cl" },
    { "key": "emailCliente", "value": "postman-cliente@test.cl" },
    { "key": "clave", "value": "ClaveSegura123" },
    { "key": "tokenEmpresa", "value": "" },
    { "key": "refreshTokenEmpresa", "value": "" },
    { "key": "tokenCliente", "value": "" },
    { "key": "tokenAdmin", "value": "" },
    { "key": "licitacionId", "value": "" },
    { "key": "postulacionId", "value": "" },
    { "key": "planId", "value": "" },
    { "key": "ventaToken", "value": "" }
  ],
  "item": [
    {
      "name": "1. Autenticacion",
      "item": [
        {
          "name": "Registrar Empresa",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{emailEmpresa}}\",\n  \"contrasena\": \"{{clave}}\",\n  \"razonSocial\": \"Constructora Postman SpA\",\n  \"rut\": \"76123456-7\",\n  \"rubro\": \"Construccion\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/registro/empresa", "host": ["{{baseUrl}}"], "path": ["api", "auth", "registro", "empresa"] }
          }
        },
        {
          "name": "Registrar Cliente",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{emailCliente}}\",\n  \"contrasena\": \"{{clave}}\",\n  \"nombreContacto\": \"Juan Postman\",\n  \"rut\": \"12345678-9\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/registro/cliente", "host": ["{{baseUrl}}"], "path": ["api", "auth", "registro", "cliente"] }
          }
        },
        {
          "name": "Login Empresa",
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "const data = pm.response.json();",
                "pm.collectionVariables.set('tokenEmpresa', data.accessToken);",
                "pm.collectionVariables.set('refreshTokenEmpresa', data.refreshToken);"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{emailEmpresa}}\",\n  \"contrasena\": \"{{clave}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          }
        },
        {
          "name": "Login Cliente",
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "const data = pm.response.json();",
                "pm.collectionVariables.set('tokenCliente', data.accessToken);"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{emailCliente}}\",\n  \"contrasena\": \"{{clave}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          }
        },
        {
          "name": "Login Administrador",
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "const data = pm.response.json();",
                "pm.collectionVariables.set('tokenAdmin', data.accessToken);"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@licitawatch.cl\",\n  \"contrasena\": \"Admin123!\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          }
        },
        {
          "name": "Refresh Token (Empresa)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{refreshTokenEmpresa}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/auth/refresh", "host": ["{{baseUrl}}"], "path": ["api", "auth", "refresh"] }
          }
        },
        {
          "name": "Logout (Empresa)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{refreshTokenEmpresa}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/auth/logout", "host": ["{{baseUrl}}"], "path": ["api", "auth", "logout"] }
          }
        }
      ]
    },
    {
      "name": "2. Perfil",
      "item": [
        {
          "name": "Ver mi perfil (Empresa)",
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{tokenEmpresa}}" }] },
            "url": { "raw": "{{baseUrl}}/api/perfil", "host": ["{{baseUrl}}"], "path": ["api", "perfil"] }
          }
        },
        {
          "name": "Actualizar perfil Empresa",
          "request": {
            "method": "PUT",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{tokenEmpresa}}" }] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"razonSocial\": \"Constructora Postman Ltda\",\n  \"rubro\": \"Construccion e Ingenieria\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/perfil/empresa", "host": ["{{baseUrl}}"], "path": ["api", "perfil", "empresa"] }
          }
        },
        {
          "name": "Ver mi perfil (Cliente)",
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{tokenCliente}}" }] },
            "url": { "raw": "{{baseUrl}}/api/perfil", "host": ["{{baseUrl}}"], "path": ["api", "perfil"] }
          }
        }
      ]
    },
    {
      "name": "3. Licitaciones",
      "item": [
        {
          "name": "Crear licitacion (Empresa)",
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "const data = pm.response.json();",
              "pm.collectionVariables.set('licitacionId', data.id);"
            ] }
          }],
          "request": {
            "method": "POST",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{tokenEmpresa}}" }] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"titulo\": \"Mantenimiento de software 2026\",\n  \"rubro\": \"Tecnologia\",\n  \"montoEstimado\": 5000000,\n  \"region\": \"Metropolitana\",\n  \"fechaCierre\": \"2026-12-31\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/licitaciones", "host": ["{{baseUrl}}"], "path": ["api", "licitaciones"] }
          }
        },
        {
          "name": "Buscar licitaciones publicadas",
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{tokenCliente}}" }] },
            "url": {
              "raw": "{{baseUrl}}/api/licitaciones?rubro=Tecnologia",
              "host": ["{{baseUrl}}"], "path": ["api", "licitaciones"],
              "query": [{ "key": "rubro", "value": "Tecnologia" }]
            }
          }
        },
        {
          "name": "Ver detalle de licitacion",
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{tokenCliente}}" }] },
            "url": { "raw": "{{baseUrl}}/api/licitaciones/{{licitacionId}}", "host": ["{{baseUrl}}"], "path": ["api", "licitaciones", "{{licitacionId}}"] }
          }
        },
        {
          "name": "Mis licitaciones (Empresa)",
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{tokenEmpresa}}" }] },
            "url": { "raw": "{{baseUrl}}/api/licitaciones/mias", "host": ["{{baseUrl}}"], "path": ["api", "licitaciones", "mias"] }
          }
        },
        {
          "name": "Actualizar licitacion (Empresa)",
          "request": {
            "method": "PUT",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{tokenEmpresa}}" }] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"titulo\": \"Mantenimiento de software 2026 (actualizado)\",\n  \"rubro\": \"Tecnologia\",\n  \"montoEstimado\": 5500000,\n  \"region\": \"Metropolitana\",\n  \"fechaCierre\": \"2026-12-31\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/licitaciones/{{licitacionId}}", "host": ["{{baseUrl}}"], "path": ["api", "licitaciones", "{{licitacionId}}"] }
          }
        },
        {
          "name": "Postular a la licitacion (Cliente)",
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "const data = pm.response.json();",
              "pm.collectionVariables.set('postulacionId', data.id);"
            ] }
          }],
          "request": {
            "method": "POST",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{tokenCliente}}" }] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"propuesta\": \"Propuesta detallada de mantenimiento de software.\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/licitaciones/{{licitacionId}}/postulaciones", "host": ["{{baseUrl}}"], "path": ["api", "licitaciones", "{{licitacionId}}", "postulaciones"] }
          }
        },
        {
          "name": "Ver postulaciones recibidas (Empresa)",
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{tokenEmpresa}}" }] },
            "url": { "raw": "{{baseUrl}}/api/licitaciones/{{licitacionId}}/postulaciones", "host": ["{{baseUrl}}"], "path": ["api", "licitaciones", "{{licitacionId}}", "postulaciones"] }
          }
        },
        {
          "name": "Aceptar postulacion (Empresa)",
          "request": {
            "method": "PUT",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{tokenEmpresa}}" }] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"estado\": \"ACEPTADA\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/licitaciones/{{licitacionId}}/postulaciones/{{postulacionId}}/estado", "host": ["{{baseUrl}}"], "path": ["api", "licitaciones", "{{licitacionId}}", "postulaciones", "{{postulacionId}}", "estado"] }
          }
        },
        {
          "name": "Mis postulaciones (Cliente)",
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{tokenCliente}}" }] },
            "url": { "raw": "{{baseUrl}}/api/postulaciones/mias", "host": ["{{baseUrl}}"], "path": ["api", "postulaciones", "mias"] }
          }
        },
        {
          "name": "Cerrar licitacion (Empresa)",
          "request": {
            "method": "PUT",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{tokenEmpresa}}" }] },
            "url": { "raw": "{{baseUrl}}/api/licitaciones/{{licitacionId}}/cerrar", "host": ["{{baseUrl}}"], "path": ["api", "licitaciones", "{{licitacionId}}", "cerrar"] }
          }
        }
      ]
    },
    {
      "name": "4. MS-Ventas",
      "item": [
        {
          "name": "Ver catalogo de planes",
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "const data = pm.response.json();",
              "const premium = data.find(p => p.nombre === 'PREMIUM');",
              "if (premium) pm.collectionVariables.set('planId', premium.id);"
            ] }
          }],
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{tokenEmpresa}}" }] },
            "url": { "raw": "{{baseUrl}}/api/planes", "host": ["{{baseUrl}}"], "path": ["api", "planes"] }
          }
        },
        {
          "name": "Iniciar venta de plan (Empresa)",
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "const data = pm.response.json();",
              "pm.collectionVariables.set('ventaToken', data.token);",
              "console.log('Abre esta URL en el navegador para pagar en el sandbox de Webpay:', data.url);"
            ] }
          }],
          "request": {
            "method": "POST",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{tokenEmpresa}}" }] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"planId\": {{planId}}\n}" },
            "url": { "raw": "{{baseUrl}}/api/ventas/iniciar", "host": ["{{baseUrl}}"], "path": ["api", "ventas", "iniciar"] },
            "description": "Devuelve {token, url}. Webpay Plus no es un simple redirect: hay que hacer un POST (formulario HTML) a 'url' con un campo oculto token_ws={{ventaToken}}. Este request de Postman solo inicia la transaccion, no completa el pago (eso requiere el formulario hospedado de Transbank en un navegador real)."
          }
        },
        {
          "name": "Confirmar pago (requiere completar el pago en Webpay primero)",
          "request": {
            "method": "POST",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{tokenEmpresa}}" }] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"tokenWs\": \"{{ventaToken}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/ventas/confirmar", "host": ["{{baseUrl}}"], "path": ["api", "ventas", "confirmar"] },
            "description": "Solo devuelve APROBADO si ya completaste el formulario de pago de Webpay Plus en un navegador con el 'url' del request anterior. Si lo llamas antes, Transbank respondera que la transaccion no existe/no esta lista."
          }
        },
        {
          "name": "Ver mi suscripcion",
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{tokenEmpresa}}" }] },
            "url": { "raw": "{{baseUrl}}/api/suscripciones/mia", "host": ["{{baseUrl}}"], "path": ["api", "suscripciones", "mia"] }
          }
        }
      ]
    },
    {
      "name": "5. LicitAsist",
      "item": [
        {
          "name": "Chatear con LicitAsist (Empresa)",
          "request": {
            "method": "POST",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{tokenEmpresa}}" }] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"mensaje\": \"¿Cuántas licitaciones tengo publicadas actualmente?\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/asistente/chat", "host": ["{{baseUrl}}"], "path": ["api", "asistente", "chat"] }
          }
        },
        {
          "name": "Ver uso del Free Tier",
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{tokenEmpresa}}" }] },
            "url": { "raw": "{{baseUrl}}/api/asistente/uso", "host": ["{{baseUrl}}"], "path": ["api", "asistente", "uso"] }
          }
        }
      ]
    },
    {
      "name": "6. Administracion (requiere Login Administrador primero)",
      "item": [
        {
          "name": "Listar usuarios",
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{tokenAdmin}}" }] },
            "url": { "raw": "{{baseUrl}}/api/admin/usuarios", "host": ["{{baseUrl}}"], "path": ["api", "admin", "usuarios"] }
          }
        },
        {
          "name": "Ver un usuario por id",
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{tokenAdmin}}" }] },
            "url": { "raw": "{{baseUrl}}/api/admin/usuarios/1", "host": ["{{baseUrl}}"], "path": ["api", "admin", "usuarios", "1"] }
          }
        },
        {
          "name": "Activar/desactivar usuario",
          "request": {
            "method": "PUT",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{tokenAdmin}}" }] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"activo\": false\n}" },
            "url": { "raw": "{{baseUrl}}/api/admin/usuarios/1/activo", "host": ["{{baseUrl}}"], "path": ["api", "admin", "usuarios", "1", "activo"] }
          }
        },
        {
          "name": "Crear otro Administrador",
          "request": {
            "method": "POST",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{tokenAdmin}}" }] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"otro-admin@licitawatch.cl\",\n  \"contrasena\": \"ClaveSegura123\",\n  \"area\": \"Soporte\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/admin/usuarios/administradores", "host": ["{{baseUrl}}"], "path": ["api", "admin", "usuarios", "administradores"] }
          }
        },
        {
          "name": "Listar todas las licitaciones",
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{tokenAdmin}}" }] },
            "url": { "raw": "{{baseUrl}}/api/licitaciones/todas", "host": ["{{baseUrl}}"], "path": ["api", "licitaciones", "todas"] }
          }
        },
        {
          "name": "Listar todas las ventas",
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{tokenAdmin}}" }] },
            "url": { "raw": "{{baseUrl}}/api/ventas/todas", "host": ["{{baseUrl}}"], "path": ["api", "ventas", "todas"] }
          }
        }
      ]
    },
    {
      "name": "7. Casos negativos (deben fallar)",
      "item": [
        {
          "name": "Sin token -> 401",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/perfil", "host": ["{{baseUrl}}"], "path": ["api", "perfil"] }
          }
        },
        {
          "name": "Cliente en ruta de Administrador -> 403",
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{tokenCliente}}" }] },
            "url": { "raw": "{{baseUrl}}/api/admin/usuarios", "host": ["{{baseUrl}}"], "path": ["api", "admin", "usuarios"] }
          }
        },
        {
          "name": "Ruta interna via Gateway -> 404",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/internal/usuarios/1", "host": ["{{baseUrl}}"], "path": ["internal", "usuarios", "1"] }
          }
        },
        {
          "name": "JSON malformado -> 400 (no 500)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ esto no es json valido" },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          }
        }
      ]
    }
  ]
}
