# ============================================================
# LicitaWatch v2 — plantilla de variables de entorno (SIN secretos)
# Copia este archivo como .env en la raíz y completa los valores <completar>.
# Cada microservicio lo lee al arrancar (spring.config.import) y el frontend solo lee VITE_*.
# ============================================================

# ---------- PostgreSQL local: 5 bases (una por MS.<dominio>.bd) ----------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<completar>
DB_USUARIOS_NAME=usuarios_bd
DB_LICITACIONES_NAME=licitaciones_bd
DB_VENTAS_NAME=ventas_bd
DB_NOTIFICACIONES_NAME=notificaciones_bd
DB_CHAT_NAME=chat_bd

# ---------- JWT (lo firma MS.usuarios.bs y lo valida el api-gateway) — mínimo 64 caracteres (HS512) ----------
JWT_SECRET=<completar>
JWT_EXPIRATION=60

# ---------- Clave para el tráfico interno gateway -> bff -> bs -> bd ----------
INTERNAL_API_KEY=<completar>

# ---------- Webpay Plus (Transbank) — SANDBOX, sin cobros reales ----------
WEBPAY_COMMERCE_CODE=597055555532
WEBPAY_API_KEY=579B532A7440BB0C9079DED94D31EA1615BACEB56610332264630D42D0A36B1C
WEBPAY_ENVIRONMENT=SANDBOX
WEBPAY_RETURN_URL=http://localhost:8080/api/pagos/webpay/retorno

# ---------- Plan Premium (la BD no guarda precio ni vigencia: van por configuración) ----------
PREMIUM_PRECIO=24990
PREMIUM_VIGENCIA_DIAS=30
ESTANDAR_POSTULACIONES_MES=3
PREMIUM_POSTULACIONES_MES=7

# ---------- Groq (LicitAsist) ----------
GROQ_API_KEY=<completar>
GROQ_MODEL=openai/gpt-oss-120b
GROQ_API_BASE_URL=https://api.groq.com/openai/v1

# ---------- Gmail SMTP ----------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=<completar>
SMTP_PASSWORD=<completar>
SMTP_FROM=<completar>
SMTP_STARTTLS=true
# Casilla que recibe las solicitudes de soporte
SOPORTE_EMAIL=<completar>

# ---------- Administrador inicial (lo crea MS.usuarios.bs al arrancar si no existe) ----------
ADMIN_EMAIL=admin@licitawatch.local
ADMIN_PASSWORD=<completar>
ADMIN_NAME=Administrador
# Caracteres no ASCII: usar escape Unicode (Spring lee .env como ISO-8859-1)
ADMIN_AREA=Administraci\u00f3n

# ---------- Archivos de licitaciones (imagen / documento) ----------
STORAGE_DIR=C:/licitawatch-storage
PUBLIC_BASE_URL=http://localhost:8080

# ---------- Rate limiting (api-gateway) ----------
RATE_LIMIT_GENERAL_PER_MINUTE=300
RATE_LIMIT_AUTH_PER_MINUTE=30
RATE_LIMIT_ASISTENTE_PER_MINUTE=20

# ---------- URLs (perfil local) ----------
FRONTEND_URL=http://localhost:5173
USUARIOS_BFF_URL=http://localhost:8111
USUARIOS_BS_URL=http://localhost:8211
USUARIOS_BD_URL=http://localhost:8311
LICITACIONES_BFF_URL=http://localhost:8112
LICITACIONES_BS_URL=http://localhost:8212
LICITACIONES_BD_URL=http://localhost:8312
VENTAS_BFF_URL=http://localhost:8113
VENTAS_BS_URL=http://localhost:8213
VENTAS_BD_URL=http://localhost:8313
VENTAS_AMBASSADOR_URL=http://localhost:8413
NOTIFICACIONES_BFF_URL=http://localhost:8114
NOTIFICACIONES_BS_URL=http://localhost:8214
NOTIFICACIONES_BD_URL=http://localhost:8314
ASISTENTE_BFF_URL=http://localhost:8115
ASISTENTE_BS_URL=http://localhost:8215
CHAT_BFF_URL=http://localhost:8116
CHAT_BS_URL=http://localhost:8216
CHAT_BD_URL=http://localhost:8316

# ---------- Frontend ----------
VITE_API_BASE_URL=http://localhost:8080
