# ============================================================
# LicitaWatch — plantilla de variables de entorno
# Copiar como ".env" en la raíz del proyecto y completar con
# credenciales reales (ver instrucciones en README.md).
# NUNCA commitear el ".env" real.
# ============================================================

# ---------- Autenticación (compartido por API Usuarios y el Gateway) ----------
JWT_SECRET=
JWT_EXPIRATION_MINUTES=30
JWT_REFRESH_EXPIRATION_DAYS=7

# ---------- API Asistente (LicitAsist) — Groq API ----------
GROQ_API_KEY=
GROQ_MODEL=
GROQ_API_BASE_URL=https://api.groq.com/openai/v1

# ---------- API MS-Ventas — Transbank Webpay Plus (ambiente integración/sandbox) ----------
TRANSBANK_ENVIRONMENT=integration
TRANSBANK_API_KEY_ID=
TRANSBANK_API_KEY_SECRET=
TRANSBANK_RETURN_URL=http://localhost:5173/pago/resultado

# ---------- API Notificaciones — SMTP (Gmail) ----------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

# ---------- Base de datos PostgreSQL (instalación NATIVA local, un solo motor, 4 BD) ----------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB_USUARIOS=usuarios_db
POSTGRES_DB_LICITACIONES=licitaciones_db
POSTGRES_DB_VENTAS=ventas_db
POSTGRES_DB_NOTIFICACIONES=notificaciones_db

# ---------- Puertos de cada servicio (procesos nativos en tu PC, sin Docker) ----------
PORT_GATEWAY=8080
PORT_USUARIOS=8081
PORT_LICITACIONES=8082
PORT_VENTAS=8083
PORT_NOTIFICACIONES=8084
PORT_ASISTENTE=8085

# ---------- Frontend ----------
VITE_API_BASE_URL=http://localhost:8080
